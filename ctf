<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SEC+ CTF // Module 1</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Orbitron:wght@400;700;900&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap');

:root {
  --bg:       #050a0f;
  --bg2:      #0a1520;
  --bg3:      #0d1e2e;
  --green:    #00ff88;
  --green2:   #00cc66;
  --green3:   #004422;
  --cyan:     #00d4ff;
  --amber:    #ffb000;
  --red:      #ff3355;
  --dim:      #1a3344;
  --text:     #b0d4e8;
  --textdim:  #4a7090;
  --border:   #0a3040;
  --glow:     0 0 20px rgba(0,255,136,0.3);
  --glowc:    0 0 20px rgba(0,212,255,0.3);
  --glowa:    0 0 20px rgba(255,176,0,0.3);
}

*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}

body {
  background: var(--bg);
  color: var(--text);
  font-family: 'Share Tech Mono', monospace;
  min-height: 100vh;
  overflow-x: hidden;
  cursor: crosshair;
}

/* Scanline overlay */
body::before {
  content:'';
  position:fixed;
  inset:0;
  background: repeating-linear-gradient(
    0deg,
    transparent,
    transparent 2px,
    rgba(0,0,0,0.03) 2px,
    rgba(0,0,0,0.03) 4px
  );
  pointer-events:none;
  z-index:1000;
}

/* Grid background */
body::after {
  content:'';
  position:fixed;
  inset:0;
  background-image:
    linear-gradient(rgba(0,255,136,0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0,255,136,0.03) 1px, transparent 1px);
  background-size: 40px 40px;
  pointer-events:none;
  z-index:0;
}

.wrap { position:relative; z-index:1; max-width:900px; margin:0 auto; padding:20px 16px 60px; }

/* ── HEADER ── */
.header {
  text-align:center;
  padding: 40px 0 30px;
  border-bottom: 1px solid var(--border);
  margin-bottom: 32px;
  position: relative;
}
.header::after {
  content:'';
  position:absolute;
  bottom:-1px; left:50%; transform:translateX(-50%);
  width:200px; height:1px;
  background: var(--green);
  box-shadow: var(--glow);
}
.header-badge {
  display:inline-block;
  border: 1px solid var(--green3);
  color: var(--green2);
  font-size: 11px;
  letter-spacing: 4px;
  padding: 4px 16px;
  margin-bottom: 16px;
}
.header h1 {
  font-family: 'Orbitron', monospace;
  font-size: clamp(24px,5vw,48px);
  font-weight: 900;
  color: var(--green);
  text-shadow: var(--glow);
  letter-spacing: 3px;
  line-height: 1.1;
}
.header h1 span { color: var(--cyan); text-shadow: var(--glowc); }
.header-sub {
  margin-top: 10px;
  font-size: 13px;
  color: var(--textdim);
  letter-spacing: 2px;
}

/* ── NAME INPUT ── */
.name-panel {
  background: var(--bg2);
  border: 1px solid var(--border);
  border-left: 3px solid var(--cyan);
  padding: 18px 24px;
  margin-bottom: 28px;
  display: flex;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
}
.name-panel label { color: var(--cyan); font-size:13px; letter-spacing:1px; white-space:nowrap; }
.name-panel input {
  flex:1; min-width:200px;
  background: var(--bg);
  border: 1px solid var(--dim);
  color: var(--green);
  font-family: 'Share Tech Mono', monospace;
  font-size: 15px;
  padding: 8px 14px;
  outline: none;
  transition: border-color 0.2s, box-shadow 0.2s;
}
.name-panel input:focus { border-color: var(--cyan); box-shadow: var(--glowc); }
.name-panel input::placeholder { color: var(--textdim); }

/* ── FRAGMENT BAR ── */
.flag-bar {
  background: var(--bg2);
  border: 1px solid var(--border);
  padding: 16px 24px;
  margin-bottom: 32px;
  position: sticky;
  top: 0;
  z-index: 50;
  backdrop-filter: blur(4px);
}
.flag-bar-label { font-size:10px; letter-spacing:3px; color: var(--textdim); margin-bottom:10px; }
.fragments {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  align-items: center;
}
.frag {
  font-family: 'Orbitron', monospace;
  font-size: 15px;
  font-weight: 700;
  padding: 6px 14px;
  border: 1px solid var(--dim);
  color: var(--textdim);
  background: var(--bg);
  min-width: 48px;
  text-align: center;
  transition: all 0.4s;
  letter-spacing: 2px;
}
.frag.revealed {
  border-color: var(--green);
  color: var(--green);
  background: rgba(0,255,136,0.08);
  box-shadow: var(--glow);
  animation: fragReveal 0.5s ease;
}
@keyframes fragReveal {
  0%{transform:scale(1.3);opacity:0} 100%{transform:scale(1);opacity:1}
}
.frag-sep { color: var(--textdim); font-size:20px; }

/* ── QUESTION CARDS ── */
.q-card {
  background: var(--bg2);
  border: 1px solid var(--border);
  margin-bottom: 24px;
  position: relative;
  transition: border-color 0.3s;
  overflow: hidden;
}
.q-card.solved { border-color: var(--green3); }
.q-card.solved::before {
  content:'';
  position:absolute;
  inset:0;
  background: linear-gradient(135deg, rgba(0,255,136,0.03) 0%, transparent 60%);
  pointer-events:none;
}

.q-header {
  display: flex;
  align-items: center;
  gap: 0;
  border-bottom: 1px solid var(--border);
  overflow: hidden;
}
.q-num {
  font-family: 'Orbitron', monospace;
  font-size: 11px;
  font-weight: 900;
  padding: 10px 16px;
  min-width: 52px;
  text-align: center;
  letter-spacing: 1px;
}
.q-objective {
  font-size: 10px;
  letter-spacing: 3px;
  color: var(--textdim);
  padding: 10px 16px;
  flex:1;
  border-left: 1px solid var(--border);
}
.q-status {
  padding: 10px 16px;
  font-size: 12px;
  color: var(--textdim);
  border-left: 1px solid var(--border);
}
.q-card.solved .q-status { color: var(--green); }

/* colour-coded by question */
.q1 .q-num { background:rgba(0,212,255,0.12); color:var(--cyan); border-bottom:2px solid var(--cyan); }
.q2 .q-num { background:rgba(255,176,0,0.12);  color:var(--amber); border-bottom:2px solid var(--amber); }
.q3 .q-num { background:rgba(0,255,136,0.12); color:var(--green); border-bottom:2px solid var(--green); }
.q4 .q-num { background:rgba(255,51,85,0.12); color:var(--red);   border-bottom:2px solid var(--red); }
.q5 .q-num { background:rgba(0,212,255,0.12); color:var(--cyan);  border-bottom:2px solid var(--cyan); }

.q-body { padding: 24px; }

.q-title {
  font-family: 'Orbitron', monospace;
  font-size: 14px;
  font-weight: 700;
  margin-bottom: 16px;
  letter-spacing: 1px;
}
.q1 .q-title{color:var(--cyan)} .q2 .q-title{color:var(--amber)}
.q3 .q-title{color:var(--green)} .q4 .q-title{color:var(--red)}
.q5 .q-title{color:var(--cyan)}

.scenario {
  background: var(--bg3);
  border-left: 3px solid var(--dim);
  padding: 14px 18px;
  margin-bottom: 18px;
  font-size: 13px;
  line-height: 1.8;
  color: var(--text);
}
.scenario strong { color: var(--amber); }
.scenario em { color: var(--cyan); font-style: normal; }

/* Certificate block */
.cert-block {
  background: var(--bg);
  border: 1px solid var(--green3);
  padding: 16px 20px;
  margin: 14px 0;
  font-size: 12px;
  line-height: 1.9;
  white-space: pre;
  overflow-x: auto;
  color: var(--text);
}
.cert-block .cert-title { color: var(--green); font-weight:bold; }
.cert-block .cert-key   { color: var(--cyan); }
.cert-block .cert-val   { color: var(--amber); }

/* Hash table */
.hash-table {
  background: var(--bg);
  border: 1px solid var(--border);
  padding: 14px 18px;
  margin: 14px 0;
  font-size: 12px;
  overflow-x: auto;
}
.hash-table table { border-collapse: collapse; width:100%; }
.hash-table th {
  color: var(--textdim);
  font-size:10px;
  letter-spacing:2px;
  text-align:left;
  padding: 4px 12px 8px 0;
  border-bottom:1px solid var(--border);
}
.hash-table td {
  padding: 6px 12px 6px 0;
  vertical-align:top;
  border-bottom:1px solid rgba(10,48,64,0.5);
  font-size:12px;
}
.hash-table .td-label { color:var(--textdim); width:110px; }
.hash-table .td-data  { color:var(--amber); }
.hash-table .td-prev  { color:var(--cyan); }
.hash-table .td-hash  { color:var(--green); font-weight:bold; }
.hash-table .tampered { color:var(--red) !important; text-decoration:line-through; }
.hash-table .tampered-note { color:var(--red); font-size:10px; }

/* Blockchain visual */
.chain-vis {
  display:flex;
  align-items:center;
  gap:0;
  margin:16px 0;
  overflow-x:auto;
  padding-bottom:4px;
}
.block-box {
  border:1px solid var(--border);
  background:var(--bg);
  padding:10px 14px;
  min-width:140px;
  flex-shrink:0;
}
.block-box .bb-num { font-size:9px; color:var(--textdim); letter-spacing:2px; margin-bottom:6px; }
.block-box .bb-data { font-size:11px; color:var(--amber); margin-bottom:4px; }
.block-box .bb-prev { font-size:10px; color:var(--textdim); }
.block-box .bb-hash { font-size:12px; color:var(--green); font-weight:bold; margin-top:6px; border-top:1px solid var(--border); padding-top:6px; }
.block-box.tampered-block { border-color:var(--red); }
.block-box.tampered-block .bb-data { color:var(--red); }
.chain-arrow { color:var(--dim); font-size:20px; padding:0 6px; flex-shrink:0; }

.q-task {
  font-size: 13px;
  color: var(--cyan);
  margin: 16px 0 12px;
  padding-left: 12px;
  border-left: 2px solid var(--cyan);
  line-height: 1.6;
}

/* Sub steps for Q4 */
.step-label {
  font-size:10px;
  letter-spacing:3px;
  color:var(--textdim);
  margin: 18px 0 8px;
}
.step-label span { color:var(--red); }

/* Answer row */
.answer-row {
  display: flex;
  gap: 10px;
  align-items: center;
  margin-top: 14px;
  flex-wrap: wrap;
}
.answer-row input {
  flex:1; min-width:200px;
  background: var(--bg);
  border: 1px solid var(--dim);
  color: var(--green);
  font-family: 'Share Tech Mono', monospace;
  font-size: 15px;
  padding: 10px 16px;
  outline: none;
  transition: border-color 0.2s, box-shadow 0.2s;
  text-transform: uppercase;
}
.answer-row input:focus { border-color:var(--green); box-shadow:var(--glow); }
.answer-row input.error { border-color:var(--red); animation:shake 0.4s ease; }
.answer-row input:disabled { opacity:0.5; cursor:not-allowed; }

@keyframes shake {
  0%,100%{transform:translateX(0)} 20%{transform:translateX(-8px)} 40%{transform:translateX(8px)} 60%{transform:translateX(-6px)} 80%{transform:translateX(6px)}
}

.btn-submit {
  background: var(--bg);
  border: 1px solid var(--green);
  color: var(--green);
  font-family: 'Share Tech Mono', monospace;
  font-size: 13px;
  padding: 10px 24px;
  cursor: pointer;
  letter-spacing: 2px;
  transition: all 0.2s;
  white-space: nowrap;
}
.btn-submit:hover { background: rgba(0,255,136,0.1); box-shadow: var(--glow); }
.btn-submit:disabled { opacity:0.4; cursor:not-allowed; }

.answer-feedback {
  margin-top: 10px;
  font-size: 12px;
  min-height: 18px;
  letter-spacing: 1px;
}
.answer-feedback.err { color: var(--red); }
.answer-feedback.ok  { color: var(--green); }

/* Fragment reveal badge */
.fragment-reveal {
  display:none;
  margin-top:16px;
  background: rgba(0,255,136,0.08);
  border: 1px solid var(--green);
  padding: 12px 18px;
  animation: fadeIn 0.5s ease;
}
.fragment-reveal.show { display:block; }
.fragment-reveal .fr-label { font-size:10px; letter-spacing:3px; color:var(--textdim); margin-bottom:6px; }
.fragment-reveal .fr-value {
  font-family:'Orbitron',monospace;
  font-size:22px;
  font-weight:900;
  color:var(--green);
  text-shadow:var(--glow);
  letter-spacing:4px;
}
.fragment-reveal .fr-hint { font-size:11px; color:var(--textdim); margin-top:6px; }

@keyframes fadeIn { from{opacity:0;transform:translateY(8px)} to{opacity:1;transform:translateY(0)} }

/* Solve checkmark overlay */
.solved-badge {
  display:none;
  position:absolute;
  top:10px; right:10px;
  width:32px; height:32px;
  background: var(--green);
  color: var(--bg);
  font-size:18px;
  align-items:center;
  justify-content:center;
  border-radius:50%;
}
.q-card.solved .solved-badge { display:flex; }

/* Key table for Q4 */
.key-table {
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(80px,1fr));
  gap:4px;
  margin:12px 0;
  background:var(--bg);
  border:1px solid var(--border);
  padding:12px;
}
.key-pair {
  display:flex;
  gap:4px;
  align-items:center;
  font-size:12px;
}
.key-pair .kp-letter { color:var(--amber); width:16px; }
.key-pair .kp-arrow  { color:var(--textdim); font-size:10px; }
.key-pair .kp-num    { color:var(--cyan); font-weight:bold; }

/* ── FINAL SUBMIT ── */
.final-panel {
  display:none;
  background:var(--bg2);
  border:1px solid var(--green);
  box-shadow:var(--glow);
  padding:28px;
  margin-top:16px;
  animation:fadeIn 0.6s ease;
}
.final-panel.show { display:block; }
.final-panel h3 {
  font-family:'Orbitron',monospace;
  color:var(--green);
  font-size:16px;
  letter-spacing:2px;
  margin-bottom:8px;
}
.final-panel p { font-size:13px; color:var(--textdim); margin-bottom:16px; line-height:1.6; }
.final-row { display:flex; gap:10px; flex-wrap:wrap; }
.final-row input {
  flex:1; min-width:200px;
  background:var(--bg);
  border:1px solid var(--green);
  color:var(--green);
  font-family:'Orbitron',monospace;
  font-size:16px;
  padding:12px 18px;
  outline:none;
  letter-spacing:3px;
  text-transform:uppercase;
}
.btn-final {
  background:var(--green);
  border:none;
  color:var(--bg);
  font-family:'Orbitron',monospace;
  font-size:13px;
  font-weight:900;
  padding:12px 28px;
  cursor:pointer;
  letter-spacing:2px;
  transition:all 0.2s;
  white-space:nowrap;
}
.btn-final:hover { background:var(--green2); box-shadow:var(--glow); }
.final-feedback { margin-top:12px; font-size:13px; min-height:20px; }
.final-feedback.err { color:var(--red); }

/* ── COMPLETION SCREEN ── */
.completion {
  display:none;
  position:fixed;
  inset:0;
  background:var(--bg);
  z-index:500;
  overflow-y:auto;
  padding:40px 20px 80px;
}
.completion.show { display:block; }
.comp-inner { max-width:700px; margin:0 auto; }
.comp-header {
  text-align:center;
  margin-bottom:40px;
}
.comp-glyph {
  font-size:64px;
  display:block;
  margin-bottom:16px;
  animation:pulse 2s ease infinite;
}
@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.6} }
.comp-header h2 {
  font-family:'Orbitron',monospace;
  font-size:clamp(20px,4vw,36px);
  font-weight:900;
  color:var(--green);
  text-shadow:var(--glow);
  letter-spacing:3px;
  margin-bottom:8px;
}
.comp-header p { color:var(--textdim); font-size:13px; letter-spacing:2px; }

.comp-receipt {
  background:var(--bg2);
  border:1px solid var(--green3);
  padding:24px 28px;
  margin-bottom:24px;
}
.comp-receipt .cr-row {
  display:flex;
  justify-content:space-between;
  padding:8px 0;
  border-bottom:1px solid var(--border);
  font-size:13px;
  gap:12px;
  flex-wrap:wrap;
}
.comp-receipt .cr-row:last-child { border-bottom:none; }
.comp-receipt .cr-label { color:var(--textdim); letter-spacing:1px; white-space:nowrap; }
.comp-receipt .cr-val   { color:var(--green); text-align:right; }
.comp-receipt .cr-val.flag-val {
  font-family:'Orbitron',monospace;
  font-size:16px;
  font-weight:900;
  letter-spacing:3px;
  color:var(--amber);
  text-shadow:var(--glowa);
}

.comp-answers {
  background:var(--bg2);
  border:1px solid var(--border);
  padding:24px 28px;
  margin-bottom:24px;
}
.comp-answers h4 {
  font-size:10px;
  letter-spacing:3px;
  color:var(--textdim);
  margin-bottom:16px;
}
.comp-ans-row {
  display:flex;
  gap:12px;
  padding:8px 0;
  border-bottom:1px solid var(--border);
  font-size:13px;
  align-items:flex-start;
  flex-wrap:wrap;
}
.comp-ans-row:last-child { border-bottom:none; }
.comp-ans-q { color:var(--textdim); width:90px; flex-shrink:0; font-size:11px; }
.comp-ans-a { color:var(--green); flex:1; }
.comp-ans-f { font-family:'Orbitron',monospace; font-size:13px; color:var(--amber); font-weight:700; letter-spacing:2px; }

.comp-footer {
  text-align:center;
  font-size:11px;
  color:var(--textdim);
  letter-spacing:2px;
  margin-top:24px;
}
.comp-footer strong { color:var(--green); }

/* hint link */
.hint-toggle {
  font-size:11px;
  color:var(--textdim);
  cursor:pointer;
  text-decoration:underline;
  margin-top:10px;
  display:inline-block;
}
.hint-toggle:hover { color:var(--cyan); }
.hint-box {
  display:none;
  background:rgba(0,212,255,0.05);
  border:1px solid rgba(0,212,255,0.2);
  padding:10px 14px;
  margin-top:8px;
  font-size:12px;
  color:var(--textdim);
  line-height:1.7;
}
.hint-box.show { display:block; }

/* ── HASH ALGORITHM REFERENCE ── */
.algo-box {
  background:var(--bg);
  border:1px solid var(--border);
  padding:14px 18px;
  margin:14px 0;
  font-size:12px;
  line-height:1.9;
}
.algo-box .algo-title { color:var(--amber); font-size:10px; letter-spacing:3px; margin-bottom:10px; }
.algo-step { display:flex; gap:10px; margin-bottom:4px; }
.algo-step-num { color:var(--green); min-width:20px; }
.algo-step-text { color:var(--text); }
.algo-example { margin-top:10px; padding-top:10px; border-top:1px solid var(--border); color:var(--textdim); font-size:11px; }

</style>
</head>
<body>

<div class="wrap">

  <!-- HEADER -->
  <header class="header">
    <div class="header-badge">SECURITY+ SY0-701 // MODULE 1</div>
    <h1>OPERATION <span>CHAIN</span>LOCK</h1>
    <p class="header-sub">CAPTURE THE FLAG &nbsp;|&nbsp; 5 OBJECTIVES &nbsp;|&nbsp; ONE FINAL KEY</p>
  </header>

  <!-- NAME -->
  <div class="name-panel">
    <label>OPERATIVE ID:</label>
    <input type="text" id="studentName" placeholder="Enter your name..." autocomplete="off" />
  </div>

  <!-- FRAGMENT BAR -->
  <div class="flag-bar">
    <div class="flag-bar-label">RECOVERED FRAGMENTS</div>
    <div class="fragments">
      <div class="frag" id="frag1" data-val="SEC">???</div>
      <div class="frag-sep">+</div>
      <div class="frag" id="frag2" data-val="+">???</div>
      <div class="frag-sep">+</div>
      <div class="frag" id="frag3" data-val="CTF">???</div>
      <div class="frag-sep">+</div>
      <div class="frag" id="frag4" data-val="2025">???</div>
      <div class="frag-sep">+</div>
      <div class="frag" id="frag5" data-val="FLAG">???</div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════════════════════
       Q1 — CONTROLS
  ══════════════════════════════════════════════════════════════ -->
  <div class="q-card q1" id="card1">
    <div class="solved-badge">✓</div>
    <div class="q-header">
      <div class="q-num">01</div>
      <div class="q-objective">DOMAIN 1.1 &nbsp;·&nbsp; SECURITY CONTROLS</div>
      <div class="q-status" id="status1">LOCKED</div>
    </div>
    <div class="q-body">
      <div class="q-title">NAME THAT CONTROL</div>
      <div class="scenario">
        <strong>// INCIDENT REPORT — REF: IR-2024-0047</strong><br><br>
        Following last quarter's breach at <em>E-MAGINE Biomedical</em>, the security team implemented two new measures.<br><br>
