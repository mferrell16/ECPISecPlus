    document.querySelector('#card'+n+' .btn-submit').disabled = true;
    document.getElementById('card'+n).classList.add('solved');
    document.getElementById('status'+n).textContent = 'CLEARED ✓';
    document.getElementById('rev'+n).classList.add('show');
    fb.textContent = '// ACCESS GRANTED';
    fb.className = 'answer-feedback ok';
    revealFragment(n);
    checkAllSolved();
  } else {
    // Wrong
    inp.classList.add('error');
    fb.textContent = '// ACCESS DENIED — incorrect. Try again.';
    fb.className = 'answer-feedback err';
    setTimeout(()=> inp.classList.remove('error'), 500);
  }
}

function revealFragment(n) {
  const el = document.getElementById('frag'+n);
  el.textContent = FRAGMENTS[n];
  el.classList.add('revealed');
}

function checkAllSolved() {
  if (Object.values(solved).every(v=>v)) {
    setTimeout(()=>{
      document.getElementById('finalPanel').classList.add('show');
      document.getElementById('finalPanel').scrollIntoView({behavior:'smooth', block:'center'});
    }, 800);
  }
}

function checkFinal() {
  const inp = document.getElementById('finalAns');
  const fb  = document.getElementById('finalFb');
  const val = norm(inp.value).replace(/\s/g,'');
  if (val === FINAL_KEY) {
    showCompletion();
  } else {
    inp.classList.add('error');
    fb.textContent = '// Key rejected. Check your fragments and try again.';
    fb.className = 'final-feedback err';
    setTimeout(()=> inp.classList.remove('error'), 500);
  }
}

function showCompletion() {
  const name = document.getElementById('studentName').value.trim() || 'UNKNOWN OPERATIVE';
  document.getElementById('cr-name').textContent = name.toUpperCase();
  document.getElementById('cr-time').textContent = new Date().toLocaleString();
  document.getElementById('completion').classList.add('show');
  window.scrollTo(0,0);
}

function toggleHint(id) {
  const box = document.getElementById(id);
  box.classList.toggle('show');
}

// Allow Enter on final input
document.getElementById('finalAns')?.addEventListener('keydown', e => {
  if (e.key === 'Enter') checkFinal();
});
</script>
</body>
</html>
